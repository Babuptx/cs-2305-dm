{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discrete Practice question block",
  "type": "object",
  "required": ["schema_version", "block_id", "pillar_id", "block_title", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "block_id": {"type": "string", "minLength": 1},
    "pillar_id": {"type": "string", "minLength": 1},
    "block_title": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "question": {
      "type": "object",
      "required": ["id", "topic", "difficulty", "question_type", "prompt", "context", "options", "correct_index", "hints", "explanation", "source_notes", "has_exhibit", "exhibit_url"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "topic": {"$ref": "#/$defs/text"},
        "difficulty": {"enum": ["foundational", "intermediate", "advanced"]},
        "question_type": {"const": "single_choice"},
        "prompt": {"$ref": "#/$defs/text"},
        "context": {"type": "string"},
        "options": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "correct_index": {"type": "integer", "minimum": 0},
        "hints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "explanation": {
          "type": "object",
          "required": ["learning_objective", "correct_rationale", "incorrect_rationales"],
          "properties": {
            "learning_objective": {"$ref": "#/$defs/text"},
            "correct_rationale": {"$ref": "#/$defs/text"},
            "incorrect_rationales": {"type": "array", "items": {"type": "object", "required": ["option_index", "rationale"], "properties": {"option_index": {"type": "integer", "minimum": 0}, "rationale": {"$ref": "#/$defs/text"}}}}
          }
        },
        "source_notes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "has_exhibit": {"type": "boolean"},
        "exhibit_url": {"type": "string"},
        "exhibit_alt": {"type": "string"},
        "verification": {"type": "object"},
        "curriculum": {
          "type": "object",
          "required": ["section", "odd_exercises", "workshop"],
          "properties": {
            "section": {"type": "string", "pattern": "^(1\\.[1345678]|2\\.[1-6]|3\\.[1-3]|4\\.[1-3])$"},
            "odd_exercises": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
            "workshop": {"$ref": "#/$defs/text"}
          }
        }
      }
    }
  }
}
